# ============================================================
# Memon Samaj Wadi – Backend Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to Git.
# ============================================================

# ─── Django Core ─────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_NAME=memon_samaj_wadi
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Configuration ───────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── OTP Provider (pluggable) ────────────────────────────────
# Supported: twilio, msg91, console (use 'console' for development)
OTP_PROVIDER=console
OTP_API_KEY=
OTP_SENDER_ID=
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=1

# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Storage Backend ─────────────────────────────────────────
# Supported: local, s3
STORAGE_BACKEND=local
# Required only if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ─── Application Config ──────────────────────────────────────
TIMEZONE=Asia/Kolkata
PENDING_EXPIRY_HOURS=24
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:8081

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated origins for the admin dashboard and mobile app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ─── Hall Settings (defaults – configurable via admin) ───────
HALL_NAME=Memon Samaj Wadi
HALL_BOOKING_PRICE=50000
HALL_ADVANCE_AMOUNT=10000

